# ==========================================
# UPSC Current Affairs Agent Environment Config
# ==========================================

# Google Gemini API Key (Get one from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SMTP Sender Configuration (e.g. Gmail)
# If using Gmail, you must generate an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_app_password_here

# Recipient Email Address(es) - Support for multiple comma-separated emails (e.g. user1@gmail.com, user2@gmail.com)
RECEIVER_EMAIL=rajramkola796@gmail.com, arnabgate494@gmail.com, shweta200208@gmail.com
